{
  "name": "wolfpak-ai",
  "version": "0.1.0",
  "description": "Pool your machines into one AI cluster. Open source. Run anywhere. Own your inference.",
  "type": "module",
  "main": "electron/main.js",
  "bin": {
    "wolfpak": "./bin/wolfpak.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "wolfpak": "tsx src/cli/index.ts",
    "desktop": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder --mac --win --linux"
  },
  "keywords": [
    "ai", "p2p", "mesh", "inference", "llm", "gguf",
    "cluster", "distributed", "wolfpak", "desktop"
  ],
  "author": "WOLFPAK AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ozzyai-sudo/wolfpak"
  },
  "homepage": "https://github.com/ozzyai-sudo/wolfpak",
  "engines": {
    "node": ">=18.0.0"
  },
  "build": {
    "appId": "ai.wolfpak.app",
    "productName": "WOLFPAK AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "desktop/**/*",
      "src/**/*",
      "bin/**/*",
      "node_modules/**/*",
      "package.json",
      "tsconfig.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "electron/icons/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ]
    },
    "win": {
      "icon": "electron/icons/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WOLFPAK AI"
    },
    "linux": {
      "icon": "electron/icons/icon.png",
      "category": "Development",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "desktop": {
        "Name": "WOLFPAK AI",
        "Comment": "Pool your machines into one AI cluster",
        "Terminal": "false"
      }
    }
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "^14.1.2",
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@libp2p/identify": "^4.1.3",
    "@libp2p/kad-dht": "^16.2.4",
    "@libp2p/mdns": "^12.0.20",
    "@libp2p/mplex": "^12.0.20",
    "@libp2p/ping": "^3.1.3",
    "@libp2p/tcp": "^11.0.18",
    "better-sqlite3": "^12.9.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "inquirer": "^13.4.2",
    "libp2p": "^3.2.4",
    "ora": "^9.4.0",
    "uuid": "^14.0.0"
  },
  "optionalDependencies": {
    "node-llama-cpp": "*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/uuid": "^10.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
